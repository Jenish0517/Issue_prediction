# ==========================================
# Environment Variables Template (.env.example)
# Copy this file to .env and fill in your actual values
# ==========================================

# Groq AI API Key (Get your key from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# JWT Secret Key for authentication token signing (Generate using: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=your_super_secret_jwt_key_here

# Optional: Database URL for PostgreSQL (Leave blank to use local SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
